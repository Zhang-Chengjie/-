<Window x:Class="ScreenCross.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="屏幕准星 - 设置" Width="600" Height="620"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <TextBlock Text="预览（实际大小）" FontWeight="Bold" Margin="0,0,0,6"/>
            <Border Background="#FF2D2D30" BorderBrush="#FF555555" BorderThickness="1"
                    Width="200" Height="200" HorizontalAlignment="Left">
                <Canvas x:Name="PreviewHost"/>
            </Border>
            <TextBlock Text="深色背景模拟游戏画面" Foreground="#FF888888" FontSize="11" Margin="0,4,0,12"/>
            <TextBlock Text="快捷键" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="F8：显示 / 隐藏准星&#x0a;Ctrl + 方向键：微调位置" FontSize="12" LineHeight="18"/>
            <Button Content="恢复默认" Margin="0,16,0,0" Padding="8,4" HorizontalAlignment="Left" Click="OnResetClick"/>
        </StackPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="准星样式" FontWeight="Bold"/>
                <ComboBox x:Name="StyleBox" DisplayMemberPath="Key" SelectedValuePath="Value"
                          Margin="0,4,0,12" SelectionChanged="OnStyleChanged"/>

                <TextBlock Text="线长（像素）" FontWeight="Bold"/>
                <Grid Margin="0,4,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="LengthSlider" Minimum="2" Maximum="50" IsSnapToTickEnabled="True"
                            TickFrequency="1" ValueChanged="OnParamChanged"/>
                    <TextBlock Grid.Column="1" x:Name="LengthValue" Text="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>

                <TextBlock Text="粗细（像素）" FontWeight="Bold"/>
                <Grid Margin="0,4,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="ThicknessSlider" Minimum="1" Maximum="16" IsSnapToTickEnabled="True"
                            TickFrequency="1" ValueChanged="OnParamChanged"/>
                    <TextBlock Grid.Column="1" x:Name="ThicknessValue" Text="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>

                <TextBlock Text="中心间距（像素）" FontWeight="Bold"/>
                <Grid Margin="0,4,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="GapSlider" Minimum="0" Maximum="30" IsSnapToTickEnabled="True"
                            TickFrequency="1" ValueChanged="OnParamChanged"/>
                    <TextBlock Grid.Column="1" x:Name="GapValue" Text="4" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>

                <TextBlock Text="不透明度" FontWeight="Bold"/>
                <Grid Margin="0,4,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1" IsSnapToTickEnabled="True"
                            TickFrequency="0.05" ValueChanged="OnParamChanged"/>
                    <TextBlock Grid.Column="1" x:Name="OpacityValue" Text="90%" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>

                <TextBlock Text="颜色" FontWeight="Bold"/>
                <WrapPanel x:Name="ColorPanel" Margin="0,4,0,4"/>
                <Button Content="自定义颜色…" Margin="0,4,0,12" Padding="8,3" HorizontalAlignment="Left" Click="OnCustomColorClick"/>

                <CheckBox x:Name="OutlineCheck" Content="描边（对比色边缘，提高可见度）" Margin="0,4,0,12"
                          Checked="OnOutlineChanged" Unchecked="OnOutlineChanged"/>

                <TextBlock Text="位置偏移（物理像素，相对屏幕中心）" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                    <TextBlock Text="X：" VerticalAlignment="Center"/>
                    <TextBox x:Name="OffsetXBox" Width="60" TextChanged="OnOffsetChanged"/>
                    <TextBlock Text="  Y：" VerticalAlignment="Center"/>
                    <TextBox x:Name="OffsetYBox" Width="60" TextChanged="OnOffsetChanged"/>
                </StackPanel>

                <TextBlock Text="显示屏幕" FontWeight="Bold"/>
                <ComboBox x:Name="MonitorBox" Margin="0,4,0,12" SelectionChanged="OnMonitorChanged"/>

                <CheckBox x:Name="AutoStartCheck" Content="开机自动运行"
                          Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged"/>

                <Button Content="关闭" Width="80" Margin="0,16,0,0" HorizontalAlignment="Right" Click="OnCloseClick"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
